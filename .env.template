# ── LeadPro v4 Configuration ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# cp .env.template .env && nano .env

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED — Core Functionality
# ═══════════════════════════════════════════════════════════════════════════
SERPER_API_KEY=                 # Serper.dev API key for Google Maps/Web search
OPENROUTER_API_KEY=             # OpenRouter API key for AI email generation
YOUR_NAME=Alex                  # Default sender display name
YOUR_COMPANY=DD Marketer        # Company name used in email footers

# ═══════════════════════════════════════════════════════════════════════════
# EMAIL — Choose Option A (Legacy SMTP) or Option B (Brevo/Cloudflare)
# ═══════════════════════════════════════════════════════════════════════════

# --- Option A: Legacy SMTP (Gmail / Office 365 / any SMTP server) ---
YOUR_EMAIL=                     # Your sending email address (e.g., you@gmail.com)
YOUR_APP_PASSWORD=              # Gmail App Password (not your regular password)
SMTP_SERVER=smtp.gmail.com      # SMTP hostname
SMTP_PORT=587                   # SMTP port (587 for TLS, 465 for SSL)
IMAP_SERVER=imap.gmail.com      # IMAP hostname for reply scanning

# --- Option B: Brevo SMTP Relay + Cloudflare Email Routing (Recommended) ---
BREVO_SMTP_LOGIN=               # Brevo SMTP login email
BREVO_SMTP_KEY=                 # Brevo SMTP key (not API key)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
CENTRAL_INBOX_EMAIL=            # Gmail inbox receiving forwarded replies
CENTRAL_INBOX_PASSWORD=         # Gmail App Password for central inbox
CENTRAL_INBOX_IMAP=imap.gmail.com

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════════════════
DB_PATH=leadpro.db              # SQLite database file path

# ═══════════════════════════════════════════════════════════════════════════
# WEB SERVER & SECURITY
# ═══════════════════════════════════════════════════════════════════════════
JWT_SECRET=generate-random-secret-on-startup   # Auto-generated if left as-is
BASE_URL=http://localhost:8000                  # Public-facing URL
TRACKING_DOMAIN=                                # Custom tracking domain (optional)
ALLOWED_ORIGINS=*                               # CORS origins (comma-separated, "*" for all)
VERIFY_SSL=true                                 # Verify SSL certificates for outgoing requests

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL INTEGRATIONS — API Keys
# ═══════════════════════════════════════════════════════════════════════════
GOOGLE_PLACES_API_KEY=          # Google Places API (alternative maps source)
YELP_API_KEY=                   # Yelp Fusion API for business data
CRUNCHBASE_API_KEY=             # Crunchbase API for company funding data
HUNTER_API_KEY=                 # Hunter.io for email verification/enrichment
CLEARBIT_API_KEY=               # Clearbit for decision-maker enrichment
PAGESPEED_API_KEY=              # Google PageSpeed Insights API
SHOPIFY_API_KEY=                # Shopify API for e-commerce data
GITHUB_API_KEY=                 # GitHub API for tech stack detection

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL — Communication Channels
# ═══════════════════════════════════════════════════════════════════════════
WHATSAPP_ACCOUNT_SID=           # WhatsApp Business API Account SID
WHATSAPP_AUTH_TOKEN=            # WhatsApp Business API Auth Token
WHATSAPP_PHONE_NUMBER=          # WhatsApp sender phone number
TWILIO_ACCOUNT_SID=             # Twilio Account SID (SMS outreach)
TWILIO_AUTH_TOKEN=              # Twilio Auth Token
TWILIO_PHONE_FROM=              # Twilio sender phone number
PHANTOMBUSTER_API_KEY=          # PhantomBuster API key (LinkedIn automation)
LINKEDIN_SESSION_COOKIE=        # LinkedIn session cookie (alternative LinkedIn)
SLACK_WEBHOOK_URL=              # Slack webhook URL for notifications
DISCORD_WEBHOOK_URL=            # Discord webhook URL for notifications

# ═══════════════════════════════════════════════════════════════════════════
# POSTFIX — Local Mail Transfer Agent (alternative SMTP)
# ═══════════════════════════════════════════════════════════════════════════
POSTFIX_HOST=                   # Postfix server hostname
POSTFIX_PORT=25                 # Postfix server port

# ═══════════════════════════════════════════════════════════════════════════
# FEATURE TOGGLES & TUNING
# ═══════════════════════════════════════════════════════════════════════════
SCHEDULER_ENABLED=true          # Enable background scheduler for follow-ups, etc.
WARMUP_ENABLED=false            # Enable email warmup system
USE_LEGACY_LEADGEN=false        # Use legacy (single-source) leadgen instead of multi-source
REPLY_INTELLIGENCE_ENABLED=true # AI-based reply classification
AB_TEST_ENABLED=true            # A/B subject line testing
FULLTEXT_SEARCH_ENABLED=true    # Full-text search on leads table

SCRAPE_THREADS=30               # Concurrent threads for web scraping
EMAIL_DELAY_SEC=20              # Delay in seconds between outgoing emails
DAILY_EMAIL_CAP=200             # Global daily email sending limit
MAX_CONCURRENT_TASKS=5          # Maximum concurrent background tasks
CACHE_TTL_SECONDS=3600          # Cache TTL in seconds (default 1 hour)
AUDIT_PAGE_EXPIRY_HOURS=48      # Audit page link expiration in hours
INTEL_COMPETITOR_COUNT=3        # Number of competitors to analyze per lead
INTEL_KEYWORD_COUNT=5           # Number of SEO keywords to track per lead

MAIL_DOMAINS=                   # Comma-separated list of owned mail domains

# ═══════════════════════════════════════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════════════════════════════════════
RATE_LIMIT_PER_MINUTE=60        # Max API requests per minute per IP
RATE_LIMIT_PER_DAY=1000         # Max API requests per day per IP

# ═══════════════════════════════════════════════════════════════════════════
# SOCIAL PROOF (customize audit pages)
# ═══════════════════════════════════════════════════════════════════════════
SOCIAL_PROOF_TEXT=              # Custom testimonial shown on audit landing pages
